# ─────────────────────────────────────────────────────────────
# Environment template — copy to .env.local and fill in real values.
#   cp .env.example .env.local
# .env.local is git-ignored. NEVER commit real secrets.
# How to obtain each value: docs/environment-setup.md and docs/auth.md.
# ─────────────────────────────────────────────────────────────

# ── Supabase (Project Settings → API) ────────────────────────
# Browser-safe (NEXT_PUBLIC_*) — baked into the client bundle at build time.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...            # same project's anon/publishable key (used by proxy.ts)

# Server-only — bypasses Row-Level Security. NEVER expose to the browser / import in src/.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...                # used by prisma/seed.ts only

# ── Database (Project Settings → Database → Connection string) ─
# Transaction pooler (:6543) for runtime queries. URL-encode special chars in the
# password (e.g. @ -> %40, / -> %2F). ?pgbouncer=true is required.
DATABASE_URL="postgresql://<user>:<password>@<host>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler (:5432) — used by `prisma migrate` only.
DIRECT_URL="postgresql://<user>:<password>@<host>.pooler.supabase.com:5432/postgres"
# Optional: pg pool size per instance. Defaults to 1 in production, 10 locally.
# DATABASE_POOL_MAX=10

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000              # production: https://yourdomain.com

# ── Dodo Payments (app.dodopayments.com → Developer) ──────────
DODO_PAYMENTS_API_KEY=<dodo-api-key>                   # Developer → API Keys
DODO_PAYMENTS_WEBHOOK_KEY=whsec_xxxxxxxx               # Developer → Webhooks → signing secret (route 500s if empty)
DODO_PAYMENTS_ENVIRONMENT=test_mode                    # test_mode | live_mode
DODO_PAYMENTS_RETURN_URL=http://localhost:3000/checkout/success
# Optional: makes one seeded dataset purchasable without running db:sync-dodo.
# DODO_TEST_PRODUCT_ID=<dodo-product-id>

# ── Email (Resend) ────────────────────────────────────────────
# Used by the contact form. Also configure Supabase custom SMTP for OTP emails
# (see docs/environment-setup.md → Supabase Auth Emails).
RESEND_API_KEY=re_xxxxxxxx
